# Copy this file to .env and fill in what you need.
# Nothing here is required to run the site: with no .env the server still
# stores every submission in the database and you read them in /admin.

# Port to listen on. Hosts usually set this for you.
PORT=8000

# Where the site and data live. Leave the defaults unless you are deploying.
SITE_DIR=.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Password for the /admin pages. Set this before you go live.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Optional: where to send a notification when a form is submitted.
# Accepts any URL that takes a JSON POST, for example a Slack or Teams webhook,
# a Zapier catch hook, or your own endpoint. Leave blank to skip.
NOTIFY_WEBHOOK_URL=

# Optional: email notifications. Needs `npm install nodemailer` first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wrenfield site <no-reply@wrenfield.co.uk>"
# Who gets the notifications, comma separated.
MAIL_TO=

# How long candidate data is kept, in days, before the nightly cleanup removes it.
# The site tells candidates 24 months, so leave this at 730 unless you change the copy.
RETENTION_DAYS=730

# Set to 1 when running behind HTTPS (any real host). Marks cookies and the
# admin session as secure.
TRUST_PROXY=1
