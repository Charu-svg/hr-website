# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Dependencies
node_modules/

# Secrets and PII. Never commit these: data/ holds briefs and applications,
# uploads/ holds candidate CVs, .env holds your admin token and SMTP password.
.env
data/
uploads/

# Reference material and working screenshots (not part of the site)
.ref/
.shots/
screencapture-*.png

# Tooling state
.commandcode/

# Vercel project link, created by `vercel link` or the first deploy
.vercel

# Editors
.vscode/
.idea/
*.swp

# Vercel environment files (the CLI writes .env.local when linking or deploying).
# The template stays trackable.
.env*
!.env.example
